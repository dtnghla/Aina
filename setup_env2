# Create and activate the conda environment
conda create -n aina python=3.8 -y
conda activate aina
conda install ninja -y

conda install -c nvidia/label/cuda-11.8.0 cuda-toolkit -y

# --- PyTorch and CUDA ---
# For CUDA 11.8, install PyTorch with the pytorch-cuda package.
# This command will install the latest PyTorch (currently 2.0.x) built with CUDA 11.8 support.
conda install pytorch torchvision torchaudio pytorch-cuda=11.8 -c pytorch -c nvidia -y

# --- Other dependencies ---
conda install h5py pyyaml -c anaconda -y
conda install sharedarray tensorboard tensorboardx yapf addict einops scipy plyfile termcolor timm -c conda-forge -y

# PyG dependencies (make sure these wheels are built for the PyTorch version/CUDA you installed)
conda install pytorch-cluster pytorch-scatter pytorch-sparse -c pyg
pip install torch-geometric

# --- spconv (SparseUNet) ---
# Ensure you install the spconv wheel built for CUDA 11.8.
pip install spconv-cu118

conda install -c conda-forge gxx=12 -y

conda install -c conda-forge libgcrypt -y

conda install -c conda-forge libxcrypt -y

# PTv1 & PTv2 or precise eval
cd libs/pointops
# usual
python setup.py install

cd ../..

conda install -c bioconda google-sparsehash -y

cd libs/pointgroup_ops

python setup.py install --include_dirs=${CONDA_PREFIX}/include